# Copy this file to .env.local and fill in real values.
# .env.local is never committed to git and is only readable by your local server.

# --- Groq (AI analysis) ---
# Free key from https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here

# --- Clerk (auth) ---
# From https://dashboard.clerk.com -> your app -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx

# --- Supabase (database + storage) ---
# From https://supabase.com/dashboard -> your project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# The "service_role" key, NOT the "anon" key. This is a powerful key that
# bypasses row-level security -- it must only ever be used server-side,
# which is exactly how this project uses it (lib/supabaseAdmin.js).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
